# Example values for Apache SetEnv directives or Windows environment variables.
# Never place a real SMTP password in a committed file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=ArgiConnect
SMTP_TIMEOUT=15
APP_ENV=production
OTP_DEV_LOG=false
OTP_DEV_SHOW=false
